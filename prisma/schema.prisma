generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id          String   @id @unique @default(uuid())
    fullName    String
    email       String   @unique
    phoneNumber String   @unique
    cep         String
    created_at  DateTime @default(now())
    updated_at  DateTime @default(now())
    categoryId  String
    category    Category @relation(fields: [categoryId], references: [id])
}

model Client {
    id          String   @id @unique @default(uuid())
    fullName    String
    email       String   @unique
    phoneNumber String   @unique
    cep         String
    created_at  DateTime @default(now())
    updated_at  DateTime @default(now())
}

model Category {
    id       String @id @unique @default(uuid())
    name     String
    imageUrl String
    users    User[]
}

model Service {
    id          String  @id @unique @default(uuid())
    name        String
    description String
    price       Decimal
}
